{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The cluster chooser: its own commands, the file dialog and the update check.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "allow-snapshot",
    "allow-add-paths",
    "allow-remove-source",
    "allow-open-cluster",
    "allow-set-menu",
    "allow-found-update",
    "allow-take-check-request",
    "allow-check-update",
    "allow-install-update",
    "allow-open-releases"
  ]
}
