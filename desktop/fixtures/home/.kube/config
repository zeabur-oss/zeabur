apiVersion: v1
kind: Config
current-context: zeabur-demo
clusters:
  - name: zeabur-demo
    cluster:
      server: http://127.0.0.1:8080
  - name: staging
    cluster:
      server: https://staging.k8s.example.com:6443
  - name: office-k3s
    cluster:
      server: https://192.0.2.10:6443
users:
  - name: demo
    user:
      token: demo-token
  - name: staging-admin
    user:
      token: not-a-real-token
  - name: office-admin
    user:
      client-certificate: certs/office-admin.crt
      client-key: certs/office-admin.key
contexts:
  - name: zeabur-demo
    context:
      cluster: zeabur-demo
      user: demo
  - name: staging
    context:
      cluster: staging
      user: staging-admin
      namespace: shop
  - name: office-k3s
    context:
      cluster: office-k3s
      user: office-admin
