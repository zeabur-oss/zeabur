{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zeabur",
  "identifier": "com.zeabur.oss.desktop",
  "build": {
    "devUrl": "http://localhost:5174",
    "frontendDist": "web/dist"
  },
  "app": {
    "windows": [],
    "enableGTKAppId": true,
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Zeabur for the clusters in your kubeconfig",
    "macOS": {
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "TradChinese",
          "SimpChinese"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/zeabur-oss/zeabur/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
