{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "engawa chart values",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "publicUrl", "issuer", "elevation", "planKey", "service", "ingress", "httpRoute", "resources"],
  "definitions": {
    "origin": {
      "description": "An https URL with a host name and no path, query or trailing slash, as browsers write an origin.",
      "type": "string",
      "pattern": "^https://[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[0-9]{1,5})?$"
    },
    "name": {
      "description": "A Kubernetes object name (DNS subdomain).",
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
      "maxLength": 253
    },
    "key": {
      "description": "A Secret or ConfigMap key.",
      "type": "string",
      "pattern": "^[-._a-zA-Z0-9]+$",
      "maxLength": 253
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "$ref": "#/definitions/name" } }
      }
    },
    "publicUrl": { "$ref": "#/definitions/origin" },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "clientId", "clientSecret"],
      "properties": {
        "url": { "$ref": "#/definitions/origin" },
        "clientId": { "type": "string", "minLength": 1 },
        "clientSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret", "key"],
          "properties": {
            "existingSecret": { "$ref": "#/definitions/name" },
            "key": { "$ref": "#/definitions/key" }
          }
        },
        "caBundle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "configMap": { "anyOf": [{ "const": "" }, { "$ref": "#/definitions/name" }] },
            "key": { "$ref": "#/definitions/key" }
          }
        }
      }
    },
    "elevation": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "metricsStore": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service": {
          "description": "A Service port as namespace/name:port, or empty for the default.",
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?/[a-z0-9]([a-z0-9-]*[a-z0-9])?:([0-9]{1,5}|[a-z0-9-]{1,15})$"
        },
        "everyoneReads": {
          "description": "Grant everyone signed in get on the ConfigMap engawa-settings.",
          "type": "boolean"
        }
      }
    },
    "planKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "existingSecret": { "anyOf": [{ "const": "" }, { "$ref": "#/definitions/name" }] },
        "key": { "$ref": "#/definitions/key" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "secretName": { "anyOf": [{ "const": "" }, { "$ref": "#/definitions/name" }] }
          }
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } },
        "parentRefs": {
          "type": "array",
          "items": { "type": "object", "required": ["name"] }
        }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "properties": { "parentRefs": { "minItems": 1 } } }
    },
    "resources": { "type": "object" },
    "podAnnotations": { "type": "object", "additionalProperties": { "type": "string" } },
    "podLabels": { "type": "object", "additionalProperties": { "type": "string" } },
    "nodeSelector": { "type": "object", "additionalProperties": { "type": "string" } },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "global": { "type": "object" }
  }
}
