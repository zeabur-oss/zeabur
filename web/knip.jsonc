{
  "$schema": "https://unpkg.com/knip@6.41.0/schema.json",
  "entry": ["e2e/**/*.ts", "playwright*.config.ts", "scripts/*.ts"],
  // Its plugin loads playwright.config.ts, which throws without a running Zeabur.
  "playwright": false,
  // unplugin-icons' JSX compiler loads it by name.
  "ignoreDependencies": ["@svgr/plugin-jsx"],
  "ignoreIssues": {
    // Generated by openapi-typescript.
    "src/api/schema.d.ts": ["types"],
  },
}
