// Unused files, exports and dependencies (https://knip.dev), run by `bun run knip` in CI.
{
  "$schema": "https://unpkg.com/knip@6.41.0/schema.json",
  "entry": ["e2e/**/*.ts", "playwright*.config.ts", "scripts/*.ts"],
  // Its plugin loads playwright.config.ts, which throws without a running engawa to test.
  "playwright": false,
  // unplugin-icons' JSX compiler loads it by name.
  "ignoreDependencies": ["@svgr/plugin-jsx"],
  "ignoreIssues": {
    // shadcn/ui components as the registry writes them, with every part they export.
    "src/components/ui/**": ["exports"],
    // Generated by openapi-typescript.
    "src/api/schema.d.ts": ["types"],
  },
}
