{
  "name": "zeabur-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && bun scripts/postbuild.ts dist",
    "typecheck": "tsc -b",
    "test": "bun test src/",
    "gen:api": "openapi-typescript ../crates/zeabur-api/openapi.yaml -o src/api/schema.d.ts && oxfmt src/api/schema.d.ts",
    "lint": "oxlint --deny-warnings",
    "knip": "knip",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@zeabur/design-system": "github:zeabur/design-system#a18960c1d488d70dab7abcd75cae18329973025d",
    "@lezer/highlight": "1.2.5",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-virtual": "3.14.13",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@iconify-json/ph": "1.2.2",
    "@playwright/test": "1.63.0",
    "@shadcn/lint": "0.2.0",
    "@svgr/core": "8.1.0",
    "@svgr/plugin-jsx": "8.1.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "knip": "6.41.0",
    "openapi-typescript": "7.13.0",
    "oxc-transform-react": "0.153.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "unplugin-icons": "24.0.0",
    "vite": "8.3.3"
