apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: shop
  namespace: demo
  annotations:
    traefik.ingress.kubernetes.io/router.middlewares: demo-shop-error-pages@kubernetescrd
    zeabur.com/maintenance-backend: '{"www.shop.example.test":[{"service":{"name":"web","port":{"number":8080}}}]}'
spec:
  rules:
    - host: shop.example.test
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service: {name: web, port: {number: 8080}}
    - host: www.shop.example.test
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service: {name: zeabur-error-pages, port: {number: 8081}}
