            "yaml": "# Signs the CA below; nothing else uses it.\napiVersion: cert-manager.io/v1\nkind: Issuer\nmetadata:\n  name: zot-selfsigned\n  namespace: zot\nspec:\n  selfSigned: {}\n---\n# A CA of its own: no public CA signs *.svc names. Nodes and buildkitd\n# trust ca.crt from the zot-tls Secret; to use a CA you already\n# distribute, point zot-tls at your own issuer instead. Ten years,\n# because every node holds a copy and rotating it means redistributing.\napiVersion: cert-manager.io/v1\nkind: Certificate\nmetadata:\n  name: zot-ca\n  namespace: zot\nspec:\n  isCA: true\n  commonName: zot-ca\n  secretName: zot-ca\n  duration: 87600h\n  privateKey:\n    algorithm: ECDSA\n    size: 256\n  issuerRef:\n    kind: Issuer\n    name: zot-selfsigned\n---\napiVersion: cert-manager.io/v1\nkind: Issuer\nmetadata:\n  name: zot-ca\n  namespace: zot\nspec:\n  ca:\n    secretName: zot-ca\n---\n# The key that signs push tokens. Zeabur Builder reads tls.key and signs\n# a short-lived token for each push; zot checks it with tls.crt. Only\n# the key matters, so a renewal keeps it (rotationPolicy: Never). zot\n# reads tls.crt once at start: to rotate the key, delete the Secret\n# zot-token-signer, wait for cert-manager to issue it again, and restart\n# zot.\napiVersion: cert-manager.io/v1\nkind: Certificate\nmetadata:\n  name: zot-token-signer\n  namespace: zot\nspec:\n  commonName: zot-token-signer\n  secretName: zot-token-signer\n  duration: 87600h\n  privateKey:\n    algorithm: Ed25519\n    encoding: PKCS8\n    rotationPolicy: Never\n  issuerRef:\n    kind: Issuer\n    name: zot-selfsigned\n"
          },
