            "yaml": "# The log store.\napiVersion: operator.victoriametrics.com/v1\nkind: VLSingle\nmetadata:\n  name: victoria-logs\n  namespace: observability\nspec:\n  # Two weeks, or less when the volume reaches 8GiB of its 10Gi.\n  retentionPeriod: 14d\n  retentionMaxDiskSpaceUsageBytes: 8GiB\n  storage:\n    resources:\n      requests: {storage: 10Gi}\n  resources:\n    requests: {cpu: 50m, memory: 64Mi}\n    limits: {memory: 1Gi}\n---\n# One collector per node, reading container logs.\napiVersion: operator.victoriametrics.com/v1\nkind: VLAgent\nmetadata:\n  name: collector\n  namespace: observability\nspec:\n  k8sCollector:\n    enabled: true\n    # Namespace, pod and container suffice; labels add cardinality.\n    includePodLabels: false\n  remoteWrite:\n    - url: http://vlsingle-victoria-logs.observability.svc:9428/internal/insert\n  resources:\n    requests: {cpu: 20m, memory: 32Mi}\n    limits: {memory: 256Mi}\n"
          }
        ],
