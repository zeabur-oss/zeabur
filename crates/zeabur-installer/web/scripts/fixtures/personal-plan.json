              "https://github.com/kubernetes-sigs/gateway-api/releases/download/v1.6.2/standard-install.yaml"
            ]
          },
          {
            "kind": "helmChart",
            "name": "traefik",
            "object": {
              "apiVersion": "helm.cattle.io/v1",
              "kind": "HelmChart",
              "metadata": {
                "annotations": {
                  "installer.zeabur.com/component": "ingress/traefik"
                },
                "labels": {
                  "app.kubernetes.io/managed-by": "zeabur-installer"
                },
                "name": "traefik",
                "namespace": "kube-system"
              },
              "spec": {
                "chart": "oci://ghcr.io/traefik/helm/traefik",
                "createNamespace": false,
                "failurePolicy": "abort",
                "targetNamespace": "traefik",
                "timeout": "10m0s",
                "valuesContent": "{\"accessLog\":{\"enabled\":true,\"fields\":{\"defaultMode\":\"drop\",\"headers\":{\"defaultMode\":\"drop\"},\"names\":{\"DownstreamContentSize\":\"keep\",\"DownstreamStatus\":\"keep\",\"Duration\":\"keep\",\"RequestContentSize\":\"keep\",\"RequestHost\":\"keep\",\"RequestMethod\":\"keep\",\"RequestPath\":\"keep\",\"RequestProtocol\":\"keep\",\"RouterName\":\"keep\",\"StartUTC\":\"keep\"},\"queryParameters\":{\"defaultMode\":\"drop\"}},\"format\":\"json\"},\"api\":{\"dashboard\":false},\"deployment\":{\"replicas\":1},\"gateway\":{\"enabled\":false},\"gatewayClass\":{\"enabled\":true,\"name\":\"traefik\"},\"providers\":{\"kubernetesCRD\":{\"allowCrossNamespace\":false,\"enabled\":true},\"kubernetesGateway\":{\"enabled\":true},\"kubernetesIngress\":{\"enabled\":true}},\"resources\":{\"limits\":{\"memory\":\"256Mi\"},\"requests\":{\"cpu\":\"50m\",\"memory\":\"64Mi\"}},\"service\":{\"spec\":{\"externalTrafficPolicy\":\"Local\"}}}",
                "version": "41.7.1"
              }
            }
          }
        ],
        "secrets": [],
        "security": "Reads Services, Secrets and routes cluster-wide; writes route status.",
        "smoke": [["gatewayclass/traefik", "--for=condition=Accepted"]],
        "why": "preset"
      },
      {
        "contributedBy": [],
        "displayName": "cert-manager",
        "id": "certificates/cert-manager",
        "idleMemoryMib": 51,
        "releases": [
          {
            "kind": "helmChart",
            "name": "cert-manager",
            "object": {
              "apiVersion": "helm.cattle.io/v1",
              "kind": "HelmChart",
              "metadata": {
                "annotations": {
                  "installer.zeabur.com/component": "certificates/cert-manager"
                },
                "labels": {
                  "app.kubernetes.io/managed-by": "zeabur-installer"
                },
                "name": "cert-manager",
                "namespace": "kube-system"
              },
              "spec": {
                "chart": "oci://quay.io/jetstack/charts/cert-manager",
                "createNamespace": false,
                "failurePolicy": "abort",
                "targetNamespace": "cert-manager",
                "timeout": "10m0s",
                "valuesContent": "{\"cainjector\":{\"resources\":{\"limits\":{\"memory\":\"128Mi\"},\"requests\":{\"cpu\":\"10m\",\"memory\":\"32Mi\"}}},\"config\":{\"apiVersion\":\"controller.config.cert-manager.io/v1alpha1\",\"enableGatewayAPI\":true,\"kind\":\"ControllerConfiguration\"},\"crds\":{\"enabled\":true,\"keep\":true},\"enableCertificateOwnerRef\":true,\"prometheus\":{\"enabled\":true,\"servicemonitor\":{\"enabled\":false}},\"resources\":{\"limits\":{\"memory\":\"128Mi\"},\"requests\":{\"cpu\":\"10m\",\"memory\":\"32Mi\"}},\"startupapicheck\":{\"resources\":{\"limits\":{\"memory\":\"64Mi\"},\"requests\":{\"cpu\":\"10m\",\"memory\":\"16Mi\"}}},\"webhook\":{\"resources\":{\"limits\":{\"memory\":\"64Mi\"},\"requests\":{\"cpu\":\"10m\",\"memory\":\"24Mi\"}}}}",
                "version": "v1.21.2"
              }
            }
          },
          {
            "kind": "manifests",
            "name": "issuers",
            "namespace": "cert-manager",
            "yaml": "# Try here first; production rate limits are far lower. Staging\n# certificates are not trusted by browsers.\napiVersion: cert-manager.io/v1\nkind: ClusterIssuer\nmetadata:\n  name: letsencrypt-staging\nspec:\n  acme:\n    server: https://acme-staging-v02.api.letsencrypt.org/directory\n    # No email: ACME accounts need no contact, and Let's Encrypt sends\n    # no expiry emails since 2025. Setting spec.acme.email later updates\n    # the registered account.\n    # Account key, created by cert-manager in its own namespace.\n    privateKeySecretRef:\n      name: letsencrypt-staging-account-key\n    solvers:\n      # HTTP-01 through Traefik's Ingress support; needs no Gateway, and\n      # also answers for names served by Gateway listeners. The name\n      # must reach port 80 of the cluster from the internet.\n      - http01:\n          ingress:\n            ingressClassName: traefik\n---\n# Trusted certificates; same settings as staging.\napiVersion: cert-manager.io/v1\nkind: ClusterIssuer\nmetadata:\n  name: letsencrypt\nspec:\n  acme:\n    server: https://acme-v02.api.letsencrypt.org/directory\n    privateKeySecretRef:\n      name: letsencrypt-account-key\n    solvers:\n      - http01:\n          ingress:\n            ingressClassName: traefik\n"
          }
        ],
        "secrets": [],
        "security": "Writes Secrets in all namespaces and manages webhook CA bundles.",
        "smoke": [
          ["clusterissuer/letsencrypt-staging", "--for=condition=Ready"],
          ["clusterissuer/letsencrypt", "--for=condition=Ready"]
        ],
        "why": "preset"
      }
    ],
