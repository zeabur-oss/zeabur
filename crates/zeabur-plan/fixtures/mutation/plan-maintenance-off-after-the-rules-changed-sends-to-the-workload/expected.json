{
  "objects": [
    {
      "target": {"apiVersion": "networking.k8s.io/v1", "kind": "Ingress", "plural": "ingresses", "name": "shop"},
      "write": {"type": "patch", "operations": [
        {"op": "test", "path": "/metadata/resourceVersion", "value": "9"},
        {"op": "test", "path": "/spec/rules/0/http/paths/0/backend", "value": {"service": {"name": "error-pages", "port": {"number": 8081}}}},
        {"op": "replace", "path": "/spec/rules/0/http/paths/0/backend", "value": {"service": {"name": "web", "port": {"number": 8080}}}},
        {"op": "test", "path": "/metadata/annotations/zeabur.com~1maintenance-backend"},
        {"op": "remove", "path": "/metadata/annotations/zeabur.com~1maintenance-backend"}
      ]}
    }
  ],
  "warnings": [
    {"code": "maintenanceRestored", "hostname": "shop.example.test", "service": "web", "port": 8080}
  ]
}
