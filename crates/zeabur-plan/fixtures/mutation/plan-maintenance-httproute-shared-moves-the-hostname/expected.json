{
  "objects": [
    {
      "target": {"kind": "HTTPRoute", "name": "web-www"},
      "write": {"type": "patch", "operations": [
        {"op": "test", "path": "/metadata/resourceVersion", "value": "5"},
        {"op": "test", "path": "/spec/hostnames/0", "value": "www.shop.example.test"},
        {"op": "remove", "path": "/spec/hostnames/0"}
      ]}
    },
    {
      "target": {"kind": "HTTPRoute", "name": "web-www-www-shop-example-test"},
      "write": {"type": "create", "body": {
        "metadata": {"name": "web-www-www-shop-example-test", "annotations": {"zeabur.com/maintenance-backend": "{\"www.shop.example.test\":[[{\"name\":\"web\",\"port\":8080}]]}"}},
        "spec": {
          "parentRefs": [{"name": "public", "namespace": "gateway"}],
          "hostnames": ["www.shop.example.test"],
          "rules": [{"backendRefs": [{"name": "error-pages", "port": 8081}]}]
        }
      }}
    }
  ],
  "warnings": [
    {"code": "domainMoved", "hostname": "www.shop.example.test", "from": {"kind": "HTTPRoute", "name": "web-www"}, "to": {"kind": "HTTPRoute", "name": "web-www-www-shop-example-test"}}
  ]
}
