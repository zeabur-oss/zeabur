{
  "objects": [
    {
      "target": {"apiVersion": "builder.zeabur.com/v1alpha1", "kind": "Build", "name": "web", "plural": "builds"},
      "write": {
        "type": "patch",
        "operations": [
          {"op": "test", "path": "/metadata/generation", "value": 2},
          {"op": "test", "path": "/spec/source/git/contextDir", "value": "apps/web"},
          {"op": "replace", "path": "/spec/source/git/contextDir", "value": "apps/site"},
          {
            "op": "add",
            "path": "/spec/env/-",
            "value": {"name": "SENTRY_TOKEN", "valueFrom": {"secretKeyRef": {"name": "web-build-env", "key": "SENTRY_TOKEN"}}}
          }
        ]
      }
    }
  ],
  "warnings": []
}
