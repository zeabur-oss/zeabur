{
  "objects": [
    {
      "target": {"apiVersion": "traefik.io/v1alpha1", "kind": "Middleware", "plural": "middlewares", "name": "shop-redirect-www-shop-example-test"},
      "write": {
        "type": "create",
        "body": {
          "metadata": {
            "name": "shop-redirect-www-shop-example-test",
            "namespace": "demo",
            "ownerReferences": [{"apiVersion": "networking.k8s.io/v1", "kind": "Ingress", "name": "shop", "uid": "7d1f5c2a-0000-4000-8000-000000000001"}]
          },
          "spec": {"redirectRegex": {
            "regex": "^https?://www\\.shop\\.example\\.test(:[0-9]+)?/(.*)",
            "replacement": "https://shop.example.test/${2}",
            "permanent": true
          }}
        }
      }
    },
    {
      "target": {"apiVersion": "networking.k8s.io/v1", "kind": "Ingress", "plural": "ingresses", "name": "shop"},
      "write": {
        "type": "patch",
        "operations": [
          {"op": "test", "path": "/metadata/resourceVersion", "value": "9"},
          {"op": "add", "path": "/metadata/annotations", "value": {"traefik.ingress.kubernetes.io/router.middlewares": "demo-shop-redirect-www-shop-example-test@kubernetescrd"}}
        ]
      }
    }
  ],
  "warnings": [{"code": "permanentRedirect", "hostname": "www.shop.example.test"}]
}
