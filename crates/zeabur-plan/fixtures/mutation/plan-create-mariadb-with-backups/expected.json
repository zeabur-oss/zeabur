{
  "objects": [
    {
      "target": {
        "apiVersion": "k8s.mariadb.com/v1alpha1",
        "kind": "MariaDB",
        "plural": "mariadbs",
        "name": "mariadb"
      },
      "resourceVersion": null,
      "before": null,
      "write": {
        "type": "create",
        "body": {
          "apiVersion": "k8s.mariadb.com/v1alpha1",
          "kind": "MariaDB",
          "metadata": {
            "name": "mariadb",
            "namespace": "demo"
          },
          "spec": {
            "image": "mariadb:12.3.3",
            "replicas": 1,
            "rootPasswordSecretKeyRef": {
              "name": "mariadb-root",
              "key": "password",
              "generate": false
            },
            "database": "app",
            "username": "app",
            "passwordSecretKeyRef": {
              "name": "mariadb-app",
              "key": "password",
              "generate": false
            },
            "storage": {
              "size": "10Gi",
              "storageClassName": "local-path"
            },
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "256Mi"
              },
              "limits": {
                "memory": "512Mi"
              }
            },
            "podSecurityContext": {
              "runAsNonRoot": true,
              "runAsUser": 999,
              "runAsGroup": 999,
              "fsGroup": 999,
              "fsGroupChangePolicy": "OnRootMismatch",
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            }
          }
        }
      }
    },
    {
      "target": {
        "apiVersion": "k8s.mariadb.com/v1alpha1",
        "kind": "Backup",
        "plural": "backups",
        "name": "mariadb-scheduled"
      },
      "resourceVersion": null,
      "before": null,
      "write": {
        "type": "create",
        "body": {
          "apiVersion": "k8s.mariadb.com/v1alpha1",
          "kind": "Backup",
          "metadata": {
            "name": "mariadb-scheduled",
            "namespace": "demo"
          },
          "spec": {
            "mariaDbRef": {
              "name": "mariadb"
            },
            "schedule": {
              "cron": "0 3 * * *"
            },
            "maxRetention": "168h",
            "compression": "gzip",
            "storage": {
              "s3": {
                "bucket": "b",
                "prefix": "mariadb",
                "endpoint": "s3.example.com",
                "region": "us-east-1",
                "accessKeyIdSecretKeyRef": {
                  "name": "mariadb-backups-s3",
                  "key": "AWS_ACCESS_KEY_ID"
                },
                "secretAccessKeySecretKeyRef": {
                  "name": "mariadb-backups-s3",
                  "key": "AWS_SECRET_ACCESS_KEY"
                },
                "tls": {
                  "enabled": true
                }
              }
            },
            "podSecurityContext": {
              "runAsNonRoot": true,
              "runAsUser": 999,
              "runAsGroup": 999,
              "fsGroup": 999,
              "fsGroupChangePolicy": "OnRootMismatch",
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "impact": [],
  "warnings": []
}
