{
  "objects": [
    {
      "target": {"apiVersion": "networking.k8s.io/v1", "kind": "Ingress", "plural": "ingresses", "name": "shop"},
      "write": {"type": "patch", "operations": [
        {"op": "test", "path": "/metadata/resourceVersion", "value": "9"},
        {"op": "test", "path": "/spec/rules/1/http/paths/0/backend", "value": {"service": {"name": "web", "port": {"number": 8080}}}},
        {"op": "replace", "path": "/spec/rules/1/http/paths/0/backend", "value": {"service": {"name": "zeabur-error-pages", "port": {"number": 8081}}}},
        {"op": "add", "path": "/metadata/annotations/zeabur.com~1maintenance-backend", "value": "{\"www.shop.example.test\":[{\"service\":{\"name\":\"web\",\"port\":{\"number\":8080}}}]}"}
      ]}
    },
    {
      "target": {"apiVersion": "traefik.io/v1alpha1", "kind": "Middleware", "plural": "middlewares", "name": "shop-error-pages"},
      "write": {"type": "patch", "operations": [
        {"op": "test", "path": "/metadata/resourceVersion", "value": "7"},
        {"op": "test", "path": "/spec/errors/status", "value": ["502-504"]},
        {"op": "replace", "path": "/spec/errors/status", "value": ["502", "504"]}
      ]}
    }
  ],
  "warnings": []
}
