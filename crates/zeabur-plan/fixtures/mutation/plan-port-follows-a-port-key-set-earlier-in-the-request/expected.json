{
  "objects": [
    {
      "target": {
        "kind": "ConfigMap",
        "name": "web-config"
      },
      "after": {
        "data": {
          "LOG_LEVEL": "info",
          "PORT": "3000"
        }
      }
    },
    {
      "target": {
        "kind": "Deployment",
        "name": "web"
      },
      "after": {
        "spec": {
          "template": {
            "spec": {
              "containers": [
                {
                  "env": null,
                  "ports": [
                    {
                      "containerPort": 3000
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ]
}
