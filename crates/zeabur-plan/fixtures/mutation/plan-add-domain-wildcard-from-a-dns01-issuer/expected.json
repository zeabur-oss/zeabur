{
  "objects": [
    {
      "target": {"kind": "Ingress", "name": "web-wildcard-example-test"},
      "write": {
        "type": "create",
        "body": {
          "metadata": {
            "name": "web-wildcard-example-test",
            "annotations": {"cert-manager.io/cluster-issuer": "letsencrypt-dns"}
          },
          "spec": {
            "rules": [{"host": "*.example.test"}],
            "tls": [{"hosts": ["*.example.test"], "secretName": "web-wildcard-example-test-tls"}]
          }
        }
      }
    }
  ],
  "warnings": [
    {"code": "httpsCertificate", "hostname": "*.example.test", "issuer": "letsencrypt-dns"}
  ]
}
