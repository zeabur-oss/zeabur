{
  "objects": [
    {
      "target": {
        "apiVersion": "moco.cybozu.com/v1beta2",
        "kind": "MySQLCluster",
        "plural": "mysqlclusters",
        "name": "mysql"
      },
      "resourceVersion": null,
      "before": null,
      "write": {
        "type": "create",
        "body": {
          "apiVersion": "moco.cybozu.com/v1beta2",
          "kind": "MySQLCluster",
          "metadata": {
            "name": "mysql",
            "namespace": "demo"
          },
          "spec": {
            "replicas": 3,
            "podTemplate": {
              "spec": {
                "securityContext": {
                  "runAsNonRoot": true,
                  "runAsUser": 10000,
                  "runAsGroup": 10000,
                  "fsGroup": 10000,
                  "fsGroupChangePolicy": "OnRootMismatch",
                  "seccompProfile": {
                    "type": "RuntimeDefault"
                  }
                },
                "containers": [
                  {
                    "name": "mysqld",
                    "image": "ghcr.io/cybozu-go/moco/mysql:8.4.10",
                    "resources": {
                      "requests": {
                        "cpu": "100m",
                        "memory": "512Mi"
                      },
                      "limits": {
                        "memory": "1Gi"
                      }
                    },
                    "securityContext": {
                      "allowPrivilegeEscalation": false,
                      "capabilities": {
                        "drop": [
                          "ALL"
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "volumeClaimTemplates": [
              {
                "metadata": {
                  "name": "mysql-data"
                },
                "spec": {
                  "accessModes": [
                    "ReadWriteOnce"
                  ],
                  "storageClassName": "local-path",
                  "resources": {
                    "requests": {
                      "storage": "10Gi"
                    }
                  }
                }
              }
            ],
            "overwriteContainers": [
              {
                "name": "agent",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                }
              },
              {
                "name": "moco-init",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                }
              },
              {
                "name": "slow-log",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "target": {
        "apiVersion": "moco.cybozu.com/v1beta2",
        "kind": "BackupPolicy",
        "plural": "backuppolicies",
        "name": "mysql-backups"
      },
      "resourceVersion": null,
      "before": null,
      "write": {
        "type": "create",
        "body": {
          "apiVersion": "moco.cybozu.com/v1beta2",
          "kind": "BackupPolicy",
          "metadata": {
            "name": "mysql-backups",
            "namespace": "demo"
          },
          "spec": {
            "schedule": "0 3 * * *",
            "concurrencyPolicy": "Forbid",
            "jobConfig": {
              "serviceAccountName": "default",
              "bucketConfig": {
                "bucketName": "b",
                "endpointURL": "https://s3.example.com",
                "usePathStyle": true
              },
              "envFrom": [
                {
                  "secretRef": {
                    "name": "mysql-backups-s3"
                  }
                }
              ],
              "workVolume": {
                "ephemeral": {
                  "volumeClaimTemplate": {
                    "spec": {
                      "accessModes": [
                        "ReadWriteOnce"
                      ],
                      "storageClassName": "local-path",
                      "resources": {
                        "requests": {
                          "storage": "10Gi"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "impact": [],
  "warnings": []
}
