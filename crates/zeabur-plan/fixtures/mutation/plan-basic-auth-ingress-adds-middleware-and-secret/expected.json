{
  "objects": [
    {
      "target": {"apiVersion": "v1", "kind": "Secret", "plural": "secrets", "name": "shop-basic-auth"},
      "write": {"type": "create", "body": {
        "metadata": {"name": "shop-basic-auth", "namespace": "demo"},
        "type": "Opaque"
      }}
    },
    {
      "target": {"apiVersion": "traefik.io/v1alpha1", "kind": "Middleware", "plural": "middlewares", "name": "shop-basic-auth"},
      "write": {"type": "create", "body": {
        "spec": {"basicAuth": {"secret": "shop-basic-auth", "removeHeader": true}}
      }}
    },
    {
      "target": {"apiVersion": "networking.k8s.io/v1", "kind": "Ingress", "plural": "ingresses", "name": "shop"},
      "write": {
        "type": "patch",
        "operations": [
          {"op": "test", "path": "/metadata/resourceVersion", "value": "9"},
          {"op": "add", "path": "/metadata/annotations", "value": {"traefik.ingress.kubernetes.io/router.middlewares": "demo-shop-basic-auth@kubernetescrd"}}
        ]
      }
    }
  ],
  "warnings": [{"code": "passwordOverHttp", "route": "shop", "hostnames": ["www.shop.example.test"]}]
}
