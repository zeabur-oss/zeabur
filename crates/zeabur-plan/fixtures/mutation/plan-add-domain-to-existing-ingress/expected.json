{
  "objects": [
    {
      "target": {
        "apiVersion": "networking.k8s.io/v1",
        "kind": "Ingress",
        "plural": "ingresses",
        "name": "shop"
      },
      "write": {
        "type": "patch",
        "operations": [
          {
            "op": "test",
            "path": "/metadata/resourceVersion",
            "value": "9"
          },
          {
            "op": "add",
            "path": "/spec/rules/-",
            "value": {
              "host": "www.example.test",
              "http": {
                "paths": [
                  {
                    "path": "/",
                    "pathType": "Prefix",
                    "backend": {
                      "service": {
                        "name": "web",
                        "port": {
                          "number": 8080
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ]
}
