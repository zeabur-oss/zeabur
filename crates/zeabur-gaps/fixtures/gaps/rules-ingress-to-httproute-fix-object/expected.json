[
  {
    "rule": "ingress-to-httproute",
    "subject": {"kind": "Ingress", "name": "shop"},
    "fix": {
      "kind": "plan",
      "id": "domains.httpRoute",
      "params": {
        "ingress": "shop",
        "object": "{\"apiVersion\":\"gateway.networking.k8s.io/v1\",\"kind\":\"HTTPRoute\",\"metadata\":{\"name\":\"shop\"},\"spec\":{\"hostnames\":[\"shop.example.test\"],\"parentRefs\":[{\"name\":\"traefik\",\"namespace\":\"kube-system\"}],\"rules\":[{\"backendRefs\":[{\"name\":\"web\",\"port\":80}],\"matches\":[{\"path\":{\"type\":\"PathPrefix\",\"value\":\"/\"}}]},{\"backendRefs\":[{\"name\":\"web\",\"port\":80}],\"matches\":[{\"path\":{\"type\":\"Exact\",\"value\":\"/health\"}}]}]}}"
      }
    }
  }
]
