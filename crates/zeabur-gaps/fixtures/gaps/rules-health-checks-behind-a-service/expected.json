[
  {
    "rule": "health-checks",
    "severity": "warning",
    "subject": {
      "kind": "Deployment",
      "name": "api",
      "fieldPath": "spec.template.spec.containers[name=api]"
    },
    "service": "projects/demo/services/deployment/api",
    "message": {"key": "gap.healthChecks.livenessOnly", "params": {"container": "api"}},
    "fix": {
      "kind": "plan",
      "id": "probes.readiness",
      "workload": {"kind": "Deployment", "name": "api"},
      "values": {"set": "tcpReadiness", "container": "api", "port": 8080, "periodSeconds": 10}
    }
  }
]
