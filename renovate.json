{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Cargo crates, web/ packages (bun.lock), action digests, the k3s test version and the Zeabur Identity pin. Lock file maintenance updates flake.lock: the Rust nightly and the Zeabur Catalog commit that zeabur-catalog embeds. scripts/bump-rke2.sh updates the pinned RKE2 release and its digests.",
  "extends": [
    "config:recommended",
    ":semanticCommitTypeAll(chore)",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Taipei",
  "schedule": [
    "* 0-5 * * 1"
  ],
  "labels": [
    "dependencies"
  ],
  "commitBody": "Signed-off-by: renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>",
  "enabledManagers": [
    "cargo",
    "bun",
    "github-actions",
    "nix",
    "custom.regex"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 0-5 * * 1"
    ]
  },
  "packageRules": [
    {
      "description": "One pull request for compatible crate updates; majors stay separate.",
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "cargo (non-major)"
    },
    {
      "description": "One pull request for compatible web/ package updates; majors stay separate.",
      "matchManagers": [
        "bun"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "web (non-major)"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "description": "The test image and the documented release move together.",
      "matchPackageNames": [
        "rancher/k3s",
        "k3s-io/k3s"
      ],
      "groupName": "k3s"
    },
    {
      "description": "Zeabur's own repositories: no publish delay.",
      "matchPackageNames": [
        "/zeabur-oss/"
      ],
      "minimumReleaseAge": null
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "k3s image used by the cluster tests (ci.yml, CONTRIBUTING.md, the scripts' defaults).",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/",
        "/^CONTRIBUTING\\.md$/",
        "/^scripts/.+\\.sh$/"
      ],
      "matchStrings": [
        "k3s: \\[(?<currentValue>v[0-9.]+-k3s[0-9]+)\\]",
        "rancher/k3s:(?<currentValue>v[0-9.]+-k3s[0-9]+)"
      ],
      "depNameTemplate": "rancher/k3s",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-k3s(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "k3s release in the install guide.",
      "managerFilePatterns": [
        "/^docs/get-started\\.md$/"
      ],
      "matchStrings": [
        "INSTALL_K3S_VERSION=(?<currentValue>v[0-9.]+\\+k3s[0-9]+)"
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Zeabur Identity commit that e2e-l2 builds and a release installs.",
      "managerFilePatterns": [
        "/^ZEABUR_IDENTITY_PINNED$/"
      ],
      "matchStrings": [
        "(?<currentDigest>[0-9a-f]{40})"
      ],
      "depNameTemplate": "zeabur-oss/identity",
      "packageNameTemplate": "https://github.com/zeabur-oss/identity",
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs"
    }
  ]
}
