# The CI jobs: scripts/ci.sh and zeabur-oss/.github README.md say what the settings mean.
# Text the code doesn't read: most of docs/, the change files and the top-level CHANGELOG.md and
# CONTRIBUTING.md. Left out: docs/reference/ and docs/get-started/ (the installer's tests include
# installer-examples/join.yaml, the telemetry test reads telemetry.mdx, and the installer's readme
# is quickstart.mdx) and the crates' README.md (rustdoc, `include_str!`).
*               rust-cache=true skip-if-only=docs/cluster/*,docs/configure/*,docs/deploy/*,docs/leave/*,docs/images/*,docs/internal/*,docs/zh-CN/*,docs/zh-TW/*,docs/index.mdx,docs/nav.yaml,docs/redirects.yaml,.changeset/*,CHANGELOG.md,CONTRIBUTING.md
# The short checks run one after another: each needs about a minute to set up a runner and its dev
# shell but much less to run.
lint
format          in=lint
clippy          in=lint
docs            in=lint
cargo-deny      in=lint
unsafe-report   in=lint
levels          in=lint
chart           in=lint
test
# fallow audit compares HEAD with HEAD^.
ui              fetch-depth=2
# Four to six minutes each, set up included: only in the merge queue, with the cluster jobs.
fuzz            tier=merge
no-ui           tier=merge
wording         tier=merge shell=zh
cluster         tier=merge
e2e             tier=merge
